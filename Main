#include "mylibrary.h"

#include <locale.h>  // Para el idioma: permite configurar tildes y caracteres españoles.
#include <stdio.h>   // Para entrada/salida: maneja los printf, scanf y la lectura de archivos (FILE).
#include <stdlib.h>  // Para memoria y control: necesaria para malloc, realloc, free y la función exit.
#include <string.h>  // Para cadenas: contiene funciones clave como strcmp (comparar) y strcpy (copiar).
#include <windows.h>

// Empiezo con 100 huecos. Si el archivo es más grande, el programa ampliará el espacio solo.
#define CAPACIDAD_INICIAL 100 


// MAIN
int main() {

    int capacidad = CAPACIDAD_INICIAL;
    Actividad* actividades = (Actividad*)malloc(capacidad * sizeof(Actividad));
    if (actividades == NULL) return 1;

    FILE* f = fopen("dataset.csv", "r"); //abro el archivo en modo read
    if (f == NULL) { printf("ERROR: No se encuentra 'dataset.csv'.\n"); free(actividades); return 1; }

    char cabecera[1000];
    int i = 0;
    fgets(cabecera, 1000, f);

    while (1) { //ordeno y almaceno cada dato del archivo
        if (i >= capacidad) {
            capacidad *= 2;
            Actividad* temp = (Actividad*)realloc(actividades, capacidad * sizeof(Actividad));
            if (temp == NULL) break;
            actividades = temp;
        }
        int r = fscanf(f, " %d %d %d %s %s %s %s %s %s %d %d %d %s",
            &actividades[i].anio, &actividades[i].mes, &actividades[i].dia,
            actividades[i].dia_semana, actividades[i].hora_inicio, actividades[i].hora_fin,
            actividades[i].actividad, actividades[i].modalidad, actividades[i].centro,
            &actividades[i].plazas, &actividades[i].ocupadas, &actividades[i].libres,
            actividades[i].tipo_actividad);

        if (r == 13) i++;
        else if (r == EOF) break;
        else fscanf(f, "%*[^\n]");
    }
    fclose(f);

    int n = i, opcionDia, opcion;
    system("COLOR 03");

    do {
        system("cls");
        Texto1();
        opcionDia = leerNumero();

        if (opcionDia == 0) break;
        if (opcionDia != 29 && opcionDia != 30 && opcionDia != 31) continue;

        do {
            system("cls");
            printf("\n MENU DE ANALISIS: DIA %d/01/2026 \n", opcionDia);
            DibujarMenu();
            escribiropciones();

            opcion = leerNumero();
            system("cls");

            switch (opcion) {
            case 1: listadoActividadesPorCentroInteractivo(actividades, n, opcionDia, 1, 2026); break;
            case 2: frecuenciaActividades(actividades, n, opcionDia, 1, 2026); break;
            case 3: actividadMasPopularPorCentro(actividades, n, opcionDia, 1, 2026); break;
            case 4: ocupacionMediaPorCentro(actividades, n, opcionDia, 1, 2026); break;
            case 5: franjasHorariasPico(actividades, n, opcionDia, 1, 2026); break;
            case 6: detectarLlenos(actividades, n, opcionDia, 1, 2026); break;
            }
            if (opcion != 0) { printf("\nPresione Enter para continuar..."); getchar(); }
        } while (opcion != 0);

    } while (opcionDia != 0);

    free(actividades);
    return 0;
}

int leerNumero() {
    char buffer[10];
    int i = 0, c_int;
    while ((c_int = getchar()) != '\n' && i < sizeof(buffer) - 1) {
        buffer[i++] = (char)c_int;
    }
    buffer[i] = '\0';
    if (i == 0) return -1;
    return atoi(buffer);
}

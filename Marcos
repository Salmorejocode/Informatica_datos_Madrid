int leerNumero() {
    char buffer[10];
    int i = 0;
    int c_int;
    printf("Introduce una opcion: ");
    while ((c_int = getchar()) != '\n' && i < sizeof(buffer) - 1) {
        buffer[i++] = (char)c_int;
    }
    buffer[i] = '\0';
    if (i == 0) {
        return -1; // Indica fin de entrada
    }
    return atoi(buffer);//Convierte la cadena del buffer en un numero entero
}


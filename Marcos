void gotoxy(int x, int y) {
    HANDLE Identiventana;
    Identiventana = GetStdHandle(STD_OUTPUT_HANDLE);
    COORD Coordenadas;
    Coordenadas.X = x;
    Coordenadas.Y = y;
    SetConsoleCursorPosition(Identiventana, Coordenadas);
}


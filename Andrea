#include <locale.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// --- 1. CONFIGURACIÓN ---
#define CAPACIDAD_INICIAL 100 // Empezamos con poco para demostrar que crece solo

typedef struct {
    int anio, mes, dia;
    char dia_semana[40];
    char hora_inicio[15];
    char hora_fin[15];
    char actividad[120];
    char modalidad[120];
    char centro[120];
    int plazas, ocupadas, libres;
    char tipo_actividad[120];
} Actividad;

// --- 2. PROTOTIPOS DE FUNCIONES ---
int esMismoDia(Actividad a, int dia, int mes, int anio);
int obtenerCentrosUnicos(Actividad *v, int n, int dia, int mes, int anio, char centros[][120]);
void listadoActividadesPorCentroInteractivo(Actividad *v, int n, int dia, int mes, int anio);
void frecuenciaActividades(Actividad *v, int n, int dia, int mes, int anio);
void actividadMasPopularPorCentro(Actividad *v, int n, int dia, int mes, int anio);
void ocupacionMediaPorCentro(Actividad *v, int n, int dia, int mes, int anio);
void franjasHorariasPico(Actividad *v, int n, int dia, int mes, int anio);
void detectarLlenos(Actividad *v, int n, int dia, int mes, int anio);

// ---------------- 3. MAIN ----------------
int main() {
    setlocale(LC_CTYPE, "spanish");

    // Reservamos memoria inicial dinámicamente
    int capacidad = CAPACIDAD_INICIAL;
    Actividad *actividades = (Actividad *)malloc(capacidad * sizeof(Actividad));
    
    if (actividades == NULL) {
        printf("ERROR: No hay memoria suficiente.\n");
        return 1;
    }

    FILE *f = fopen("dataset.csv", "r");
    if (f == NULL) {
        printf("ERROR: No se encuentra el archivo 'dataset.csv'.\n");
        free(actividades); // Siempre liberar antes de salir
        return 1;
    }

    char cabecera[1000];
    int i = 0;
    fgets(cabecera, 1000, f); // Saltar cabecera

   
    while (1) {
        // Si nos quedamos sin espacio, duplicamos la memoria con realloc
        if (i >= capacidad) {
            capacidad *= 2;
            Actividad *temp = (Actividad *)realloc(actividades, capacidad * sizeof(Actividad));
            if (temp == NULL) {
                printf("ERROR: Se agotó la memoria al expandir el array.\n");
                break; 
            }
            actividades = temp;
        }

        int r = fscanf(f, " %d %d %d %s %s %s %s %s %s %d %d %d %s",
                  &actividades[i].anio, &actividades[i].mes, &actividades[i].dia,
                  actividades[i].dia_semana, actividades[i].hora_inicio, actividades[i].hora_fin,
                  actividades[i].actividad, actividades[i].modalidad, actividades[i].centro,
                  &actividades[i].plazas, &actividades[i].ocupadas, &actividades[i].libres,
                  actividades[i].tipo_actividad);
        
        if (r == 13) {
            i++;
        } else if (r == EOF) {
            break; 
        } else {
            fscanf(f, "%*[^\n]"); // Salta línea corrupta
        }
    }
    fclose(f);

    int n = i;
    

    int opcionDia, opcion;
    int mes = 1, anio = 2026;

    do {
        printf("\n========================================\n");
        printf("        CALENDARIO DE ACTIVIDADES       \n");
        printf("========================================\n");
        printf("Elija un dia (29, 30, 31) o 0 para SALIR: ");
        
        if (scanf("%d", &opcionDia) != 1) {
            while(getchar() != '\n'); continue;
        }
        if (opcionDia == 0) break;

        int totalDia = 0;
        for(int k=0; k<n; k++) if(actividades[k].dia == opcionDia) totalDia++;

        if(totalDia == 0) {
            printf("[!] No hay datos para el dia %d.\n", opcionDia);
            continue;
        }

        do {
            printf("\n--- MENU DE ANALISIS: DIA %d/01/2026 ---\n", opcionDia);
            printf("1. Ver actividades por Centro Deportivo\n");
            printf("2. Ver frecuencia de sesiones ofertadas\n");
            printf("3. Identificar actividad mas popular por centro\n");
            printf("4. Ver ocupacion media por centro (%%)\n");
            printf("5. Ver franjas horarias con mas actividad\n");
            printf("6. Listar actividades sin plazas libres\n");
            printf("0. Volver al calendario\n");
            printf("Opcion: ");
            scanf("%d", &opcion);

            switch(opcion) {
                case 1: listadoActividadesPorCentroInteractivo(actividades, n, opcionDia, mes, anio); break;
                case 2: frecuenciaActividades(actividades, n, opcionDia, mes, anio); break;
                case 3: actividadMasPopularPorCentro(actividades, n, opcionDia, mes, anio); break;
                case 4: ocupacionMediaPorCentro(actividades, n, opcionDia, mes, anio); break;
                case 5: franjasHorariasPico(actividades, n, opcionDia, mes, anio); break;
                case 6: detectarLlenos(actividades, n, opcionDia, mes, anio); break;
            }
        } while(opcion != 0);

    } while(opcionDia != 0);

    // LIBERACIÓN DE MEMORIA: Indispensable al usar malloc/realloc
    free(actividades);
    printf("\nMemoria liberada con éxito. Adiós.\n");

    return 0;
}

// ---------------- 4. FUNCIONES DE LÓGICA ----------------

int esMismoDia(Actividad a, int dia, int mes, int anio) {
    return (a.dia == dia && a.mes == mes && a.anio == anio);
}

int obtenerCentrosUnicos(Actividad *v, int n, int dia, int mes, int anio, char centros[][120]) {
    int numCentros = 0;
    for (int i = 0; i < n; i++) {
        if (esMismoDia(v[i], dia, mes, anio)) {
            int existe = 0;
            for (int j = 0; j < numCentros; j++) {
                if (strcmp(centros[j], v[i].centro) == 0) { existe = 1; break; }
            }
            if (!existe && numCentros < 100) {
                strcpy(centros[numCentros], v[i].centro);
                numCentros++;
            }
        }
    }
    return numCentros;
}

void listadoActividadesPorCentroInteractivo(Actividad *v, int n, int dia, int mes, int anio) {
    char centros[100][120];
    int numC = obtenerCentrosUnicos(v, n, dia, mes, anio, centros);
    int sel;
    if(numC == 0) return;

    printf("\nSELECCIONE UN CENTRO:\n");
    for (int i = 0; i < numC; i++) printf("%d. %s\n", i + 1, centros[i]);
    printf("Opcion: ");
    scanf("%d", &sel);

    if (sel > 0 && sel <= numC) {
        char* centroElegido = centros[sel-1];
        printf("\n--- ACTIVIDADES EN %s ---\n", centroElegido);
        printf("%-20s | %-12s | %-12s | %-10s\n", "ACTIVIDAD", "HORARIO", "MODALIDAD", "LIBRES");
        for (int j = 0; j < n; j++) {
            if (esMismoDia(v[j], dia, mes, anio) && strcmp(v[j].centro, centroElegido) == 0) {
                printf("%-20s | %s-%s | %-12s | %d/%d\n", 
                       v[j].actividad, v[j].hora_inicio, v[j].hora_fin, v[j].modalidad, v[j].libres, v[j].plazas);
            }
        }
    }
}

void frecuenciaActividades(Actividad *v, int n, int dia, int mes, int anio) {
    char nombres[200][120];
    int conteo[200] = {0}, numA = 0;
    for (int i = 0; i < n; i++) {
        if (esMismoDia(v[i], dia, mes, anio)) {
            int idx = -1;
            for (int j = 0; j < numA; j++) if (strcmp(nombres[j], v[i].actividad) == 0) { idx = j; break; }
            if (idx != -1) conteo[idx]++;
            else if (numA < 200) { strcpy(nombres[numA], v[i].actividad); conteo[numA] = 1; numA++; }
        }
    }
    printf("\n--- FRECUENCIA DE ACTIVIDADES (%d/%d) ---\n", dia, mes);
    for (int i = 0; i < numA; i++) printf("%-25s: %d veces\n", nombres[i], conteo[i]);
}

void actividadMasPopularPorCentro(Actividad *v, int n, int dia, int mes, int anio) {
    char centros[100][120];
    int numC = obtenerCentrosUnicos(v, n, dia, mes, anio, centros);
    printf("\n--- MAS POPULAR POR CENTRO ---\n");
    for (int i = 0; i < numC; i++) {
        int maxOcu = -1, idx = -1;
        for (int j = 0; j < n; j++) {
            if (esMismoDia(v[j], dia, mes, anio) && strcmp(v[j].centro, centros[i]) == 0) {
                if (v[j].ocupadas > maxOcu) { maxOcu = v[j].ocupadas; idx = j; }
            }
        }
        if (idx != -1) printf("%-25s: %s (%d ocupados)\n", centros[i], v[idx].actividad, maxOcu);
    }
}

void ocupacionMediaPorCentro(Actividad *v, int n, int dia, int mes, int anio) {
    char centros[100][120];
    int numC = obtenerCentrosUnicos(v, n, dia, mes, anio, centros);
    printf("\n--- OCUPACION MEDIA POR CENTRO ---\n");
    for (int i = 0; i < numC; i++) {
        int sumOcu = 0, sumPla = 0;
        for (int j = 0; j < n; j++) {
            if (esMismoDia(v[j], dia, mes, anio) && strcmp(v[j].centro, centros[i]) == 0) {
                sumOcu += v[j].ocupadas; sumPla += v[j].plazas;
            }
        }
        float porc = (sumPla > 0) ? ((float)sumOcu / sumPla) * 100 : 0;
        printf("%-25s: %.1f%%\n", centros[i], porc);
    }
}

void franjasHorariasPico(Actividad *v, int n, int dia, int mes, int anio) {
    char horas[100][15];
    int conteo[100] = {0}, numH = 0;
    for (int i = 0; i < n; i++) {
        if (esMismoDia(v[i], dia, mes, anio)) {
            int idx = -1;
            for (int j = 0; j < numH; j++) if (strcmp(horas[j], v[i].hora_inicio) == 0) { idx = j; break; }
            if (idx != -1) conteo[idx]++;
            else if (numH < 100) { strcpy(horas[numH], v[i].hora_inicio); conteo[numH] = 1; numH++; }
        }
    }
    printf("\n--- ACTIVIDADES POR FRANJA ---\n");
    for (int i = 0; i < numH; i++) printf("Hora %s: %d sesiones\n", horas[i], conteo[i]);
}

void detectarLlenos(Actividad *v, int n, int dia, int mes, int anio) {
    int cont = 0;
    printf("\n--- ACTIVIDADES SIN PLAZAS LIBRES ---\n");
    for (int i = 0; i < n; i++) {
        if (esMismoDia(v[i], dia, mes, anio) && v[i].libres == 0) {
            printf("[LLENO] %s en %s (%s)\n", v[i].actividad, v[i].centro, v[i].hora_inicio);
            cont++;
        }
    }
    if (cont == 0) printf("No hay actividades completas en este dia.\n");
}

